{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "types": ["@webgpu/types"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.js",
    "build/**/*.d.ts"
  ],
  "exclude": ["node_modules", "build/release.wat"]
}