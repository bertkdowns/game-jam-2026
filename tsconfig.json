{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    
    "baseUrl": "./",
    "paths": {
      "@engine_core/*": ["src/engine_core/*"], 
      "@components/*": ["src/components/*"],
      "@game/*": ["src/game/*"],
      "@interface/*": ["src/interface/*"],
      "@wasm_interface/*": ["src/wasm_interface/*"],
      "@as_wasm/*": ["src/as_wasm/*"],
    }
  },
  "include": ["./**/*.ts", "./**/*"],
  "exclude": ["node_modules", "build/**/*", "dist/**/*"]
}

